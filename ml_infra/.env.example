# Application Environment Settings
ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=

# Vector Search
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Storage Backend (local or s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/images
S3_BUCKET_NAME=genie-product-intelligence
AWS_REGION=eu-west-1

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# NVIDIA NIM AI Cloud (Vision, OCR & Multimodal Reasoning)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Greenbook Mirror Path
GREENBOOK_DB_PATH=./data/greenbook/greenbook.db
